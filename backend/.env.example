# Backend Environment Variables Example Template

# Project Metadata
PROJECT_NAME="Smart AI Doubt Router"
API_V1_STR="/api/v1"

# Security (Generate a secure key in production using `openssl rand -hex 32`)
SECRET_KEY="SUPER_SECRET_SECURITY_PASSPHRASE_CHANGE_IN_PRODUCTION"

# Database Link (Adjust user/password/host/port as needed)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_doubt_system"

# Redis Cache & Queue Broker Link
REDIS_URL="redis://localhost:6379/0"

# AI Dynamic Thresholds
AI_SIMILARITY_THRESHOLD=0.82

# Mailer Configurations
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST="smtp.gmail.com"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAILS_FROM_EMAIL="no-reply@ai-doubt-system.edu"

# FCM (Firebase Notification Credentials, Optional JSON string)
# FIREBASE_CREDENTIALS_JSON='{"type": "service_account", ...}'
